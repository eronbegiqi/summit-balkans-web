# ─── Resend (email) ────────────────────────────────────────────────────────────
# Create free account at https://resend.com
# Add & verify your domain, then create an API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "From" address — must match your verified Resend domain
RESEND_FROM=Summit Balkans <hello@summitbalkans.com>

# Where admin alerts (new bookings, contacts, enquiries) are sent
ADMIN_EMAIL=hello@summitbalkans.com

# ─── Airtable (CRM / database) ─────────────────────────────────────────────────
# Create free account at https://airtable.com
# Create a new base called "Summit Balkans CRM"
# Go to https://airtable.com/create/tokens → create a Personal Access Token
#   Scopes: data.records:read, data.records:write
#   Access: your base
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Find your Base ID in the Airtable API docs:
#   Go to https://airtable.com/developers/web/api/introduction → select your base
#   The URL contains /airtable.com/developers/web/api/introduction#baseId
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ─── Cloudflare R2 (image uploads) ─────────────────────────────────────────────
# Required for admin image uploads.
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=summit-balkans
R2_PUBLIC_URL=https://media.summitbalkans.com

# ─── Anthropic (weekly automated blog draft) ───────────────────────────────────
# Powers /api/cron/blog-post — researches a keyword weekly and saves a
# draft blog post for review. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" so the
# cron routes reject requests from anyone else. Optional locally, required
# in production (set the same value in the Vercel project's cron config).
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL — used to build absolute links in emails and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.summitbalkans.com
